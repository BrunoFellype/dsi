NODE_ENV=development
PORT=3333
SIGAA_MOCK=0
SIGAA_URL=https://sigs.ufrpe.br
ALLOWED_ORIGIN=*
TRUST_PROXY=0
DISCORD_BOT_TOKEN=replace-with-discord-bot-token
DISCORD_ALLOWED_CHANNELS=[{"guildId":"discord-server-id","channelId":"discord-channel-id","estudanteIds":["firebase-user-id"]}]
AI_API_KEY=replace-with-ai-api-key
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"firebase-project-id","private_key_id":"replace-me","private_key":"replace-with-service-account-private-key","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com","client_id":"replace-me"}
FIREBASE_PROJECT_ID=firebase-project-id
